<?php

namespace App\Http\Controllers;

use App\Models\PackagingBox;
use Illuminate\Http\Request;

class PackagingBoxController extends Controller
{
    public function index()
    {
        $boxes = PackagingBox::latest()->paginate(20);

        return view('packaging-boxes.index', compact('boxes'));
    }

    public function create()
    {
        return view('packaging-boxes.form', [
            'box' => null,
        ]);
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'box_name'        => 'required|string|max:255',
            'inner_height_cm' => 'required|numeric|min:0.01',
            'inner_width_cm'  => 'required|numeric|min:0.01',
            'inner_length_cm' => 'required|numeric|min:0.01',
            'max_weight_kg'   => 'required|numeric|min:0.001',
            'box_weight_kg'   => 'nullable|numeric|min:0',
            'status'          => 'nullable|boolean',
        ]);

        $data['box_weight_kg'] = $data['box_weight_kg'] ?? 0;
        $data['status'] = $request->has('status');

        PackagingBox::create($data);

        return redirect()
            ->route('packaging-boxes.index')
            ->with('success', 'Packaging box created successfully.');
    }

    public function edit(PackagingBox $packaging_box)
    {
        return view('packaging-boxes.form', [
            'box' => $packaging_box,
        ]);
    }

    public function update(Request $request, PackagingBox $packaging_box)
    {
        $data = $request->validate([
            'box_name'        => 'required|string|max:255',
            'inner_height_cm' => 'required|numeric|min:0.01',
            'inner_width_cm'  => 'required|numeric|min:0.01',
            'inner_length_cm' => 'required|numeric|min:0.01',
            'max_weight_kg'   => 'required|numeric|min:0.001',
            'box_weight_kg'   => 'nullable|numeric|min:0',
            'status'          => 'nullable|boolean',
        ]);

        $data['box_weight_kg'] = $data['box_weight_kg'] ?? 0;
        $data['status'] = $request->has('status');

        $packaging_box->update($data);

        return redirect()
            ->route('packaging-boxes.index')
            ->with('success', 'Packaging box updated successfully.');
    }

    public function destroy(PackagingBox $packaging_box)
    {
        $packaging_box->delete();

        return back()->with('success', 'Packaging box deleted successfully.');
    }
}

