<?php

namespace App\Services;

use App\Models\PackagingBox;
use Exception;

class PackingService
{
    protected float $volumetricDivisor = 5000;

    public function packOrder($orderItems): array
    {
        $items = $this->expandItems($orderItems);

        if (empty($items)) {
            throw new Exception('No order items found for packing.');
        }

        $boxes = PackagingBox::where('status', 1)
            ->orderByRaw('(inner_height_cm * inner_width_cm * inner_length_cm) ASC')
            ->get();

        if ($boxes->isEmpty()) {
            throw new Exception('No active packaging boxes found.');
        }

        $packages = [];

        while (count($items) > 0) {
            $package = $this->packSingleBox($items, $boxes);

            if (!$package) {
                throw new Exception('Some products do not fit in any available box.');
            }

            $packages[] = $package['package'];
            $items = $package['remaining_items'];
        }

        return $packages;
    }

    private function expandItems($orderItems): array
    {
        $items = [];

        foreach ($orderItems as $orderItem) {
            for ($i = 1; $i <= $orderItem->quantity; $i++) {
                $height = (float) $orderItem->height_cm;
                $width  = (float) $orderItem->width_cm;
                $length = (float) $orderItem->length_cm;
                $weight = (float) $orderItem->weight_kg;

                $items[] = [
                    'order_item_id' => $orderItem->id,
                    'product_id'    => $orderItem->product_id,
                    'product_name'  => $orderItem->product_name,
                    'sku'           => $orderItem->sku,
                    'height'        => $height,
                    'width'         => $width,
                    'length'        => $length,
                    'weight'        => $weight,
                    'volume'        => $height * $width * $length,
                ];
            }
        }

        usort($items, fn ($a, $b) => $b['volume'] <=> $a['volume']);

        return $items;
    }

    private function packSingleBox(array $items, $boxes): ?array
    {
        foreach ($boxes as $box) {
            $boxVolume = $box->inner_height_cm * $box->inner_width_cm * $box->inner_length_cm;

            $usedVolume = 0;
            $usedWeight = (float) $box->box_weight_kg;

            $packedItems = [];
            $remainingItems = [];

            foreach ($items as $item) {
                $itemFitsDimension = $this->itemFitsInBox($item, $box);
                $itemFitsVolume = ($usedVolume + $item['volume']) <= $boxVolume;
                $itemFitsWeight = ($usedWeight + $item['weight']) <= $box->max_weight_kg;

                if ($itemFitsDimension && $itemFitsVolume && $itemFitsWeight) {
                    $packedItems[] = $item;
                    $usedVolume += $item['volume'];
                    $usedWeight += $item['weight'];
                } else {
                    $remainingItems[] = $item;
                }
            }

            if (count($packedItems) > 0) {
                $volumetricWeight = $this->calculateVolumetricWeight(
                    $box->inner_length_cm,
                    $box->inner_width_cm,
                    $box->inner_height_cm
                );

                return [
                    'package' => [
                        'box_id' => $box->id,
                        'box_name' => $box->box_name,

                        'height_cm' => (float) $box->inner_height_cm,
                        'width_cm'  => (float) $box->inner_width_cm,
                        'length_cm' => (float) $box->inner_length_cm,

                        'actual_weight_kg' => round($usedWeight, 3),
                        'volumetric_weight_kg' => round($volumetricWeight, 3),
                        'chargeable_weight_kg' => round(max($usedWeight, $volumetricWeight), 3),

                        'items' => $packedItems,
                    ],
                    'remaining_items' => $remainingItems,
                ];
            }
        }

        return null;
    }

    private function itemFitsInBox(array $item, $box): bool
    {
        $itemDimensions = [
            $item['height'],
            $item['width'],
            $item['length'],
        ];

        $boxDimensions = [
            (float) $box->inner_height_cm,
            (float) $box->inner_width_cm,
            (float) $box->inner_length_cm,
        ];

        sort($itemDimensions);
        sort($boxDimensions);

        return $itemDimensions[0] <= $boxDimensions[0]
            && $itemDimensions[1] <= $boxDimensions[1]
            && $itemDimensions[2] <= $boxDimensions[2];
    }

    private function calculateVolumetricWeight($length, $width, $height): float
    {
        return ((float) $length * (float) $width * (float) $height) / $this->volumetricDivisor;
    }
}

