2. Box Selection Logic
Formula

$itemVolume = height * width * length;
$boxVolume = inner_height * inner_width * inner_length;
$totalWeight = itemWeight * quantity;



Chargeable Weight

Most courier APIs use:

$volumetricWeight = ($length * $width * $height) / 5000;
$chargeableWeight = max($actualWeight, $volumetricWeight);

3. Packing Service

class PackingService
{
    public function packOrder($orderItems)
    {
        $items = [];

        foreach ($orderItems as $item) {
            for ($i = 1; $i <= $item->quantity; $i++) {
                $items[] = [
                    'product_id' => $item->product_id,
                    'name' => $item->product_name,
                    'height' => $item->height_cm,
                    'width' => $item->width_cm,
                    'length' => $item->length_cm,
                    'weight' => $item->weight_kg,
                    'volume' => $item->height_cm * $item->width_cm * $item->length_cm,
                ];
            }
        }

        usort($items, function ($a, $b) {
            return $b['volume'] <=> $a['volume'];
        });

        $boxes = PackagingBox::where('status', 1)
            ->orderByRaw('(inner_height_cm * inner_width_cm * inner_length_cm) ASC')
            ->get();

        $packages = [];

        while (count($items) > 0) {
            $packed = false;

            foreach ($boxes as $box) {
                $boxVolume = $box->inner_height_cm * $box->inner_width_cm * $box->inner_length_cm;
                $usedVolume = 0;
                $usedWeight = $box->box_weight_kg;
                $packageItems = [];

                foreach ($items as $key => $item) {
                    if (
                        $item['height'] <= $box->inner_height_cm &&
                        $item['width'] <= $box->inner_width_cm &&
                        $item['length'] <= $box->inner_length_cm &&
                        ($usedVolume + $item['volume']) <= $boxVolume &&
                        ($usedWeight + $item['weight']) <= $box->max_weight_kg
                    ) {
                        $packageItems[] = $item;
                        $usedVolume += $item['volume'];
                        $usedWeight += $item['weight'];
                        unset($items[$key]);
                    }
                }

                if (count($packageItems) > 0) {
                    $packages[] = [
                        'box_id' => $box->id,
                        'box_name' => $box->box_name,
                        'height' => $box->inner_height_cm,
                        'width' => $box->inner_width_cm,
                        'length' => $box->inner_length_cm,
                        'actual_weight' => $usedWeight,
                        'volumetric_weight' => ($box->inner_length_cm * $box->inner_width_cm * $box->inner_height_cm) / 5000,
                        'items' => array_values($packageItems),
                    ];

                    $items = array_values($items);
                    $packed = true;
                    break;
                }
            }

            if (!$packed) {
                throw new Exception('Some products do not fit in any available box.');
            }
        }

        return $packages;
    }
}


4. NZ Shipping API Flow

Because different NZ APIs have different payloads, keep one common interface:
    interface ShippingProviderInterface
{
    public function getRates($order, $packages);
    public function createShipment($order, $packages, $serviceCode);
    public function trackShipment($trackingNumber);
}


5. Example NZ Shipping Service

class NzShippingService implements ShippingProviderInterface
{
    protected $apiUrl;
    protected $apiKey;

    public function __construct()
    {
        $this->apiUrl = config('shipping.nz.api_url');
        $this->apiKey = config('shipping.nz.api_key');
    }

    public function getRates($order, $packages)
    {
        $payload = [
            'sender' => [
                'name' => config('shipping.sender.name'),
                'address1' => config('shipping.sender.address1'),
                'city' => config('shipping.sender.city'),
                'postcode' => config('shipping.sender.postcode'),
                'country' => 'NZ',
            ],
            'receiver' => [
                'name' => $order->customer_name,
                'address1' => $order->shipping_address,
                'city' => $order->shipping_city,
                'postcode' => $order->shipping_postcode,
                'country' => 'NZ',
            ],
            'packages' => collect($packages)->map(function ($package) {
                return [
                    'height_cm' => $package['height'],
                    'width_cm' => $package['width'],
                    'length_cm' => $package['length'],
                    'weight_kg' => max(
                        $package['actual_weight'],
                        $package['volumetric_weight']
                    ),
                ];
            })->values()->toArray(),
        ];

        $response = Http::withHeaders([
            'Authorization' => 'Bearer ' . $this->apiKey,
            'Accept' => 'application/json',
        ])->post($this->apiUrl . '/rates', $payload);

        if (!$response->successful()) {
            throw new Exception('Shipping rate API failed.');
        }

        return $response->json();
    }

    public function createShipment($order, $packages, $serviceCode)
    {
        $payload = [
            'order_reference' => $order->order_no,
            'service_code' => $serviceCode,
            'packages' => $packages,
        ];

        $response = Http::withHeaders([
            'Authorization' => 'Bearer ' . $this->apiKey,
            'Accept' => 'application/json',
        ])->post($this->apiUrl . '/shipments', $payload);

        if (!$response->successful()) {
            throw new Exception('Shipment creation failed.');
        }

        return $response->json();
    }

    public function trackShipment($trackingNumber)
    {
        $response = Http::withHeaders([
            'Authorization' => 'Bearer ' . $this->apiKey,
        ])->get($this->apiUrl . '/tracking/' . $trackingNumber);

        return $response->json();
    }
}


6. Order Checkout Flow

public function calculateShipping($orderId)
{
    $order = Order::with('items')->findOrFail($orderId);

    $packingService = new PackingService();
    $packages = $packingService->packOrder($order->items);

    foreach ($packages as $package) {
        OrderPackage::create([
            'order_id' => $order->id,
            'packaging_box_id' => $package['box_id'],
            'box_name' => $package['box_name'],
            'height_cm' => $package['height'],
            'width_cm' => $package['width'],
            'length_cm' => $package['length'],
            'actual_weight_kg' => $package['actual_weight'],
            'volumetric_weight_kg' => $package['volumetric_weight'],
            'chargeable_weight_kg' => max($package['actual_weight'], $package['volumetric_weight']),
            'items_json' => json_encode($package['items']),
        ]);
    }

    $shippingService = new NzShippingService();
    $rates = $shippingService->getRates($order, $packages);

    foreach ($rates['services'] as $rate) {
        ShippingRate::create([
            'order_id' => $order->id,
            'provider' => 'NZ',
            'service_name' => $rate['name'],
            'service_code' => $rate['code'],
            'amount' => $rate['price'],
            'currency' => $rate['currency'] ?? 'NZD',
            'eta' => $rate['eta'] ?? null,
            'raw_response' => json_encode($rate),
        ]);
    }

    return $rates;
}


