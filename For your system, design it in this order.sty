use App\Models\ShippingShipment;
use App\Models\ShippingShipment;
public function createShipment(Order $order)
{
    try {
        DB::beginTransaction();

        $order->load(['packages']);

        if (!$order->shipping_service_code) {
            return back()->with('error', 'Please select shipping method first.');
        }

        if ($order->packages->isEmpty()) {
            return back()->with('error', 'Please calculate shipping packages first.');
        }

        $packages = $order->packages->map(function ($package) {
            return [
                'height_cm' => $package->height_cm,
                'width_cm' => $package->width_cm,
                'length_cm' => $package->length_cm,
                'actual_weight_kg' => $package->actual_weight_kg,
                'volumetric_weight_kg' => $package->volumetric_weight_kg,
                'chargeable_weight_kg' => $package->chargeable_weight_kg,
                'items' => $package->items_json,
            ];
        })->toArray();

        $shippingService = new NZShippingService();

        $response = $shippingService->createShipment(
            $order,
            $packages,
            $order->shipping_service_code
        );

        $trackingNumber = $response['tracking_number']
            ?? $response['trackingNumber']
            ?? null;

        $labelUrl = $response['label_url']
            ?? $response['labelUrl']
            ?? $response['label_pdf']
            ?? null;

        ShippingShipment::updateOrCreate(
            ['order_id' => $order->id],
            [
                'provider' => $order->shipping_provider,
                'service_code' => $order->shipping_service_code,
                'service_name' => $order->shipping_service_name,
                'tracking_number' => $trackingNumber,
                'label_url' => $labelUrl,
                'request_payload' => [
                    'order_id' => $order->id,
                    'packages' => $packages,
                ],
                'response_payload' => $response,
                'status' => 'created',
            ]
        );

        $order->update([
            'tracking_number' => $trackingNumber,
            'shipping_label_url' => $labelUrl,
            'status' => 'shipment_created',
        ]);

        DB::commit();

        return back()->with('success', 'Shipment created successfully.');

    } catch (Exception $e) {
        DB::rollBack();

        Log::error('Shipment creation failed', [
            'order_id' => $order->id,
            'message' => $e->getMessage(),
        ]);

        return back()->with('error', $e->getMessage());
    }
}


