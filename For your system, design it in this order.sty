<?php

namespace App\Http\Controllers;

use App\Models\Order;
use App\Models\OrderPackage;
use App\Models\ShippingRate;
use App\Services\PackingService;
use App\Services\Shipping\NZShippingService;
use Exception;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;

class OrderShippingController extends Controller
{
    public function calculate(Request $request, Order $order)
    {
        try {
            DB::beginTransaction();

            $order->load('items');

            if ($order->items->isEmpty()) {
                return back()->with('error', 'Order has no items.');
            }

            // Remove old package/rate calculation
            OrderPackage::where('order_id', $order->id)->delete();
            ShippingRate::where('order_id', $order->id)->delete();

            // 1. Pack order items into best boxes
            $packingService = new PackingService();
            $packages = $packingService->packOrder($order->items);

            // 2. Save packages
            foreach ($packages as $package) {
                OrderPackage::create([
                    'order_id' => $order->id,
                    'packaging_box_id' => $package['box_id'],
                    'box_name' => $package['box_name'],

                    'height_cm' => $package['height_cm'],
                    'width_cm' => $package['width_cm'],
                    'length_cm' => $package['length_cm'],

                    'actual_weight_kg' => $package['actual_weight_kg'],
                    'volumetric_weight_kg' => $package['volumetric_weight_kg'],
                    'chargeable_weight_kg' => $package['chargeable_weight_kg'],

                    'items_json' => $package['items'],
                ]);
            }

            // 3. Call NZ Shipping API
            $shippingService = new NZShippingService();
            $apiResponse = $shippingService->getRates($order, $packages);

            // 4. Save shipping rates
            $services = $apiResponse['services'] ?? $apiResponse['rates'] ?? [];

            if (empty($services)) {
                DB::rollBack();
                return back()->with('error', 'No shipping rates found from API.');
            }

            foreach ($services as $service) {
                ShippingRate::create([
                    'order_id' => $order->id,
                    'provider' => $service['provider'] ?? 'NZ',
                    'service_name' => $service['name'] ?? $service['service_name'] ?? null,
                    'service_code' => $service['code'] ?? $service['service_code'] ?? null,
                    'amount' => $service['price'] ?? $service['amount'] ?? 0,
                    'currency' => $service['currency'] ?? 'NZD',
                    'eta' => $service['eta'] ?? $service['delivery_time'] ?? null,
                    'raw_response' => $service,
                ]);
            }

            $order->update([
                'status' => 'shipping_calculated',
            ]);

            DB::commit();

            return redirect()
                ->route('orders.shipping-options', $order->id)
                ->with('success', 'Shipping rates calculated successfully.');

        } catch (Exception $e) {
            DB::rollBack();

            Log::error('Shipping calculation failed', [
                'order_id' => $order->id,
                'message' => $e->getMessage(),
            ]);

            return back()->with('error', $e->getMessage());
        }
    }

    public function shippingOptions(Order $order)
    {
        $order->load(['items', 'packages', 'shippingRates']);

        return view('orders.shipping-options', compact('order'));
    }

    public function selectShipping(Request $request, Order $order)
    {
        $request->validate([
            'shipping_rate_id' => 'required|exists:shipping_rates,id',
        ]);

        $rate = ShippingRate::where('order_id', $order->id)
            ->where('id', $request->shipping_rate_id)
            ->firstOrFail();

        $order->update([
            'shipping_provider' => $rate->provider,
            'shipping_service_code' => $rate->service_code,
            'shipping_service_name' => $rate->service_name,
            'shipping_amount' => $rate->amount,
            'total_amount' => $order->subtotal + $rate->amount,
        ]);

        return redirect()
            ->route('orders.show', $order->id)
            ->with('success', 'Shipping method selected successfully.');
    }
}


