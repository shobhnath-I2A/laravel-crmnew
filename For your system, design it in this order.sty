7. Optional Cron Command
php artisan make:command UpdateShipmentTracking

public function handle()
{
    $shipments = ShippingShipment::whereNotNull('tracking_number')
        ->whereNotIn('status', ['delivered', 'cancelled'])
        ->get();

    $shippingService = new NZShippingService();

    foreach ($shipments as $shipment) {
        try {
            $response = $shippingService->trackShipment($shipment->tracking_number);

            $status = $response['status']
                ?? $response['tracking_status']
                ?? $response['current_status']
                ?? null;

            $shipment->update([
                'tracking_status' => $status,
                'tracking_message' => $response['message'] ?? null,
                'response_payload' => $response,
                'last_tracked_at' => now(),
                'status' => strtolower($status) === 'delivered' ? 'delivered' : $shipment->status,
            ]);

        } catch (Exception $e) {
            Log::error('Cron tracking failed', [
                'shipment_id' => $shipment->id,
                'message' => $e->getMessage(),
            ]);
        }
    }

    $this->info('Shipment tracking updated successfully.');
}


