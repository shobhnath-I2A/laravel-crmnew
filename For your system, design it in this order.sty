<?php

namespace App\Services\Shipping;

use Exception;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class NZShippingService implements ShippingProviderInterface
{
    protected string $apiUrl;
    protected string $apiKey;
    protected ?string $accountNumber;

    public function __construct()
    {
        $this->apiUrl = rtrim(config('shipping.nz.api_url'), '/');
        $this->apiKey = config('shipping.nz.api_key');
        $this->accountNumber = config('shipping.nz.account_number');

        if (!$this->apiUrl || !$this->apiKey) {
            throw new Exception('NZ shipping API credentials are missing.');
        }
    }

    public function getRates($order, array $packages): array
    {
        $payload = [
            'account_number' => $this->accountNumber,

            'sender' => $this->senderPayload(),

            'receiver' => [
                'name' => $order->customer_name,
                'phone' => $order->customer_phone,
                'email' => $order->customer_email,
                'address1' => $order->shipping_address,
                'city' => $order->shipping_city,
                'state' => $order->shipping_state,
                'postcode' => $order->shipping_postcode,
                'country' => $order->shipping_country ?? 'NZ',
            ],

            'packages' => $this->packagePayload($packages),

            'options' => [
                'currency' => 'NZD',
                'signature_required' => false,
                'residential' => true,
            ],
        ];

        return $this->post('/rates', $payload);
    }

    public function createShipment($order, array $packages, string $serviceCode): array
    {
        $payload = [
            'account_number' => $this->accountNumber,
            'order_reference' => $order->order_no,
            'service_code' => $serviceCode,

            'sender' => $this->senderPayload(),

            'receiver' => [
                'name' => $order->customer_name,
                'phone' => $order->customer_phone,
                'email' => $order->customer_email,
                'address1' => $order->shipping_address,
                'city' => $order->shipping_city,
                'state' => $order->shipping_state,
                'postcode' => $order->shipping_postcode,
                'country' => $order->shipping_country ?? 'NZ',
            ],

            'packages' => $this->packagePayload($packages),

            'label_format' => 'PDF',
        ];

        return $this->post('/shipments', $payload);
    }

    public function trackShipment(string $trackingNumber): array
    {
        return $this->get('/tracking/' . urlencode($trackingNumber));
    }

    private function senderPayload(): array
    {
        return [
            'name' => config('shipping.sender.name'),
            'phone' => config('shipping.sender.phone'),
            'email' => config('shipping.sender.email'),
            'address1' => config('shipping.sender.address1'),
            'address2' => config('shipping.sender.address2'),
            'city' => config('shipping.sender.city'),
            'postcode' => config('shipping.sender.postcode'),
            'country' => config('shipping.sender.country', 'NZ'),
        ];
    }

    private function packagePayload(array $packages): array
    {
        return collect($packages)->map(function ($package, $index) {
            return [
                'reference' => 'PKG-' . ($index + 1),
                'height_cm' => (float) $package['height_cm'],
                'width_cm' => (float) $package['width_cm'],
                'length_cm' => (float) $package['length_cm'],
                'weight_kg' => (float) $package['chargeable_weight_kg'],
                'actual_weight_kg' => (float) $package['actual_weight_kg'],
            ];
        })->values()->toArray();
    }

    private function post(string $endpoint, array $payload): array
    {
        try {
            $response = Http::timeout(30)
                ->withHeaders($this->headers())
                ->post($this->apiUrl . $endpoint, $payload);

            if (!$response->successful()) {
                Log::error('NZ Shipping API POST failed', [
                    'endpoint' => $endpoint,
                    'status' => $response->status(),
                    'response' => $response->body(),
                    'payload' => $payload,
                ]);

                throw new Exception('NZ Shipping API request failed.');
            }

            return $response->json() ?? [];

        } catch (Exception $e) {
            Log::error('NZ Shipping API error', [
                'endpoint' => $endpoint,
                'message' => $e->getMessage(),
            ]);

            throw $e;
        }
    }

    private function get(string $endpoint): array
    {
        try {
            $response = Http::timeout(30)
                ->withHeaders($this->headers())
                ->get($this->apiUrl . $endpoint);

            if (!$response->successful()) {
                Log::error('NZ Shipping API GET failed', [
                    'endpoint' => $endpoint,
                    'status' => $response->status(),
                    'response' => $response->body(),
                ]);

                throw new Exception('NZ Shipping tracking request failed.');
            }

            return $response->json() ?? [];

        } catch (Exception $e) {
            Log::error('NZ Shipping tracking error', [
                'endpoint' => $endpoint,
                'message' => $e->getMessage(),
            ]);

            throw $e;
        }
    }

    private function headers(): array
    {
        return [
            'Authorization' => 'Bearer ' . $this->apiKey,
            'Accept' => 'application/json',
            'Content-Type' => 'application/json',
        ];
    }
}

Important
The endpoints below are placeholders:
/rates
/shipments
/tracking/{tracking_number}

Replace them according to your selected NZ courier API docs, for example:
