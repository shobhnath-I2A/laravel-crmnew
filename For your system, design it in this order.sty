    use App\Models\ShippingShipment;
use App\Services\Shipping\NZShippingService;
use Illuminate\Support\Facades\Log;



public function trackShipment(Order $order)
{
    try {
        $shipment = ShippingShipment::where('order_id', $order->id)->first();

        if (!$shipment || !$shipment->tracking_number) {
            return back()->with('error', 'Tracking number not found.');
        }

        $shippingService = new NZShippingService();

        $response = $shippingService->trackShipment($shipment->tracking_number);

        $trackingStatus = $response['status']
            ?? $response['tracking_status']
            ?? $response['current_status']
            ?? null;

        $trackingMessage = $response['message']
            ?? $response['tracking_message']
            ?? $response['description']
            ?? null;

        $shipment->update([
            'tracking_status' => $trackingStatus,
            'tracking_message' => $trackingMessage,
            'response_payload' => $response,
            'last_tracked_at' => now(),
        ]);

        if ($trackingStatus) {
            $orderStatus = match (strtolower($trackingStatus)) {
                'delivered' => 'delivered',
                'in_transit', 'in transit', 'out_for_delivery', 'out for delivery' => 'shipped',
                default => $order->status,
            };

            $order->update([
                'status' => $orderStatus,
            ]);
        }

        return back()->with('success', 'Tracking updated successfully.');

    } catch (Exception $e) {
        Log::error('Tracking update failed', [
            'order_id' => $order->id,
            'message' => $e->getMessage(),
        ]);

        return back()->with('error', $e->getMessage());
    }
}



